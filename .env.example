# Server only. Never commit certificates or private keys.
PORT=3000
PASS_TYPE_IDENTIFIER=pass.com.yourcompany.pocketpass
APPLE_TEAM_IDENTIFIER=YOURTEAMID
PASS_ORGANIZATION=PocketPass
PASS_CERT_PATH=./certs/signerCert.pem
PASS_KEY_PATH=./certs/signerKey.pem
APPLE_WWDR_PATH=./certs/wwdr.pem
PASS_KEY_PASSPHRASE=
# For a separate GitHub Pages frontend, set its exact origin (no path).
ALLOWED_ORIGIN=https://aaidh.github.io
# Frontend build setting: signing server HTTPS origin, or empty for same host.
VITE_API_URL=
